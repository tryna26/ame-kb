# LLM (OpenAI-compatible endpoint)
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding (OpenAI-compatible /embeddings endpoint; can be a separate service)
EMBED_API_KEY=sk-xxxx
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

# Aliyun RDS MySQL 8.0 (public endpoint). Add your IP to the RDS whitelist.
MYSQL_DSN=mysql+pymysql://user:pass@rm-xxxx.mysql.rds.aliyuncs.com:3306/ame_kb?charset=utf8mb4

# Source folder to scan for .md/.txt
SOURCE_DIR=./data

# Logical graph identity (V1 keeps these fixed)
GRAPH_NO=default
GRAPH_VERSION=1

# Hybrid recall params
RECALL_TOPK=5
RECALL_NEIGHBOR_TOPK=3
MIN_SCORE_TEXT=0
MIN_SCORE_EMBEDDING=0
