# LLM (OpenAI-compatible endpoint)
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding (OpenAI-compatible /embeddings endpoint; can be a separate service)
EMBED_API_KEY=sk-xxxx
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

# Aliyun RDS MySQL 8.0 (public endpoint). Add your IP to the RDS whitelist.
MYSQL_DSN=mysql+pymysql://user:pass@rm-xxxx.mysql.rds.aliyuncs.com:3306/ame_kb?charset=utf8mb4

# Source folder to scan for .md/.txt
SOURCE_DIR=./data

# Default graph identity. Managed-graph CLI/API requests override these through
# a request/task-local GraphContext; an omitted version resolves latest ACTIVE.
GRAPH_NO=default
GRAPH_VERSION=1

# Hybrid recall params
RECALL_TOPK=5
RECALL_NEIGHBOR_TOPK=3
MIN_SCORE_TEXT=0
MIN_SCORE_EMBEDDING=0

# --- V4 ---
# Search backend: mysql (FULLTEXT+JSON cosine) or redis (RediSearch FT+VECTOR).
# Both fuse text+vector with the same client-side RRF.
SEARCH_BACKEND=mysql
# Redis (same cloud host as MySQL is fine). NOTE: RediSearch can only create an
# index on db 0, so REDIS_URL must point at /0; keys are isolated by
# REDIS_INDEX_PREFIX. Redis Stack / RediSearch module required. Recommend
# noeviction + AOF on the instance.
REDIS_URL=redis://localhost:6379/0
REDIS_INDEX_PREFIX=amekb
# Embedding dimension for the Redis VECTOR field. 0 = auto-probe from the
# embedding endpoint on first use.
EMBED_DIM=0

# Doc chunking (doc-chunk fallback channel)
CHUNK_SIZE=800
CHUNK_OVERLAP=200
DOC_CHUNK_TOPK=10

# Multi-query fusion: 1 = original query only (V3 behaviour); >1 = LLM rewrites.
RECALL_MAX_QUERIES=1
# Multi-hop neighbor expansion: 1 = V3 one-hop; 2 = two-hop, etc.
RECALL_MAX_HOPS=1
# Retry ladder: 0 = single pass (V3). >0 = retry with looser thresholds until
# this many seeds are found (graph_scope is NEVER relaxed).
RECALL_MIN_RESULTS=0
RETRY_STRICT_TEXT=0.8
RETRY_STRICT_EMBEDDING=0.8

# --- V5 ---
# Entity fusion (resolve): candidate top-K per node and the vector min-score for
# the duplicate-candidate channel.
RESOLVE_CANDIDATE_TOPK=10
RESOLVE_MIN_SCORE_EMBEDDING=0

# --- V6.2 durable background pipeline ---
# database = MySQL polling only; redis = Redis wake-up queue + MySQL fallback.
# Keep this Redis DB/instance separate from RediSearch (which must use db 0).
PIPELINE_QUEUE_BACKEND=database
PIPELINE_REDIS_URL=redis://localhost:6379/1
PIPELINE_QUEUE_KEY=amekb:pipeline:ready
PIPELINE_POLL_SECONDS=2
PIPELINE_RETRY_DELAY_SECONDS=5
# A crashed worker's RUNNING task becomes reclaimable after this lease expires.
PIPELINE_LEASE_SECONDS=900
