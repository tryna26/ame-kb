# LLM (OpenAI-compatible endpoint)
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Aliyun RDS MySQL 8.0 (public endpoint). Add your IP to the RDS whitelist.
MYSQL_DSN=mysql+pymysql://user:pass@rm-xxxx.mysql.rds.aliyuncs.com:3306/ame_kb?charset=utf8mb4

# Source folder to scan for .md/.txt
SOURCE_DIR=./data

# Logical graph identity (V1 keeps these fixed)
GRAPH_NO=default
GRAPH_VERSION=1
