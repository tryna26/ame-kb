# LLM (OpenAI-compatible endpoint)
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding model is always explicit. API key/base URL may be omitted to reuse
# LLM_API_KEY/LLM_BASE_URL; the chat model is never used as an embedding model.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# Aliyun RDS MySQL 8.0 (public endpoint). Add your IP to the RDS whitelist.
MYSQL_DSN=mysql+pymysql://user:pass@rm-xxxx.mysql.rds.aliyuncs.com:3306/ame_kb?charset=utf8mb4

# Source folder to scan for .md/.txt
SOURCE_DIR=./data
# Optional stable namespace for multiple roots with the same relative doc paths.
SOURCE_ID=default

# Logical graph identity (V1 keeps these fixed)
GRAPH_NO=default
GRAPH_VERSION=1

# Entity-resolution similarity gates.
RESOLVE_LOW_THRESHOLD=0.75
RESOLVE_HIGH_THRESHOLD=0.92
RESOLVE_CANDIDATE_TOPK=10
